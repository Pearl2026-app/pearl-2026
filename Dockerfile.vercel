# API image, used two ways (build context: the repository root):
#   Vercel  — the `api` container service in vercel.json (serves HTTP; Vercel sets PORT).
#   Fly.io  — the background worker (apps/api/fly.toml runs `node dist/worker.js`).
# Local:  docker build -f Dockerfile.vercel -t sahyadri-api .
# The slim Debian image keeps each deployment small (Vercel stores every image: the full image was 2.6 GB).
# Prisma needs OpenSSL and the CA list (TLS to the database); they are copied from the official full image.
FROM node:22-bookworm AS ssl

FROM node:22-bookworm-slim AS base
COPY --from=ssl /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/
COPY --from=ssl /usr/bin/openssl /usr/bin/openssl
COPY --from=ssl /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

FROM base AS build
COPY . .
# Only the API and the packages it uses.
RUN pnpm install --frozen-lockfile --filter "@sahyadri/api..." \
  && pnpm --filter "@sahyadri/api..." build

FROM base AS runtime
ENV NODE_ENV=production PORT=4000 STORAGE_LOCAL_DIR=/data/uploads
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
EXPOSE 4000
# Migrations are not run here: the "Database migrations" GitHub workflow applies them on push to main.
CMD ["node", "--enable-source-maps", "dist/main.js"]
