# API image, used two ways (build context: the repository root):
#   Vercel  — the `api` container service in vercel.json (serves HTTP; Vercel sets PORT).
#   Fly.io  — the background worker (apps/api/fly.toml runs `node dist/worker.js`).
# Local:  docker build -f Dockerfile.vercel -t sahyadri-api .
# The full Debian image already has OpenSSL (needed by Prisma) and CA certificates, so no apt step.
FROM node:22-bookworm AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

FROM base AS build
COPY . .
# Only the API and the packages it uses.
RUN pnpm install --frozen-lockfile --filter "@sahyadri/api..." \
  && pnpm --filter "@sahyadri/api..." build

FROM base AS runtime
ENV NODE_ENV=production PORT=4000 STORAGE_LOCAL_DIR=/data/uploads
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
EXPOSE 4000
# Migrations are not run here: the "Database migrations" GitHub workflow applies them on push to main.
CMD ["node", "--enable-source-maps", "dist/main.js"]
