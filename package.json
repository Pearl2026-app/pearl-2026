{
  "name": "sahyadri-pearls",
  "private": true,
  "version": "0.1.0",
  "description": "Sahyadri Pearls storefront, business platform and mobile apps",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @sahyadri/db generate",
    "db:migrate": "pnpm --filter @sahyadri/db migrate:deploy",
    "db:seed": "pnpm --filter @sahyadri/db seed",
    "format": "prettier --write .",
    "e2e": "node e2e/reset-db.mjs && playwright test -c e2e",
    "load": "node scripts/load/load.mjs",
    "api:docs": "pnpm --filter @sahyadri/api build && node --env-file=apps/api/.env apps/api/dist/openapi.js docs/api/openapi.json && node scripts/api-reference.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "~15.5.0",
    "@playwright/test": "1.64.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "@types/react": "19.2.18",
      "sharp": "^0.35.5",
      "postcss@<8.5.23": "^8.5.29",
      "js-yaml@<5.4.1": "^5.4.3"
    }
  }
}
