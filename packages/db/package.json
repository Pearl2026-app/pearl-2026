{
  "name": "@sahyadri/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src seed",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx seed/seed.ts",
    "studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "@sahyadri/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "~6.19.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@types/node": "^22.10.0"
  }
}
