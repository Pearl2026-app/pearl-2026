{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "git": {
    "deploymentEnabled": {
      "sahyadri-pearls-phase-0": false
    }
  },
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @sahyadri/web... --filter @sahyadri/mobile-customer... --filter @sahyadri/mobile-delivery...",
      "buildCommand": "cd ../.. && bash scripts/demo/export-apps.sh && pnpm --filter \"@sahyadri/web...\" build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @sahyadri/admin...",
      "buildCommand": "cd ../.. && pnpm --filter \"@sahyadri/admin...\" build"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "dist/main.js",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @sahyadri/api...",
      "buildCommand": "cd ../.. && bash scripts/vercel/api-build.sh",
      "functions": {
        "dist/main.js": {
          "maxDuration": 60,
          "includeFiles": "bundled-media/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/media/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/system/tick",
      "schedule": "30 21 * * *"
    }
  ]
}
