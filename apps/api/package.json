{
  "name": "@sahyadri/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@sahyadri/db": "workspace:*",
    "@sahyadri/shared": "workspace:*",
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sahyadri/api-client": "workspace:*",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsc-watch": "^7.1.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.7"
  }
}
