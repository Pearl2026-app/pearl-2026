# Sahyadri Pearls — environment variables
# Copy to .env and fill in. Never commit real values.
# Every third-party service has a documented fallback (docs/API-OUTLINE.md, "Providers").

# ── Core ───────────────────────────────────────────────────────────
NODE_ENV=development
# Public URLs, used for links in WhatsApp/email messages, sitemap and QR codes
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
# Web and admin servers reach the API here (private URL when they share a network; defaults to API_URL)
API_INTERNAL_URL=

# ── Database and cache ─────────────────────────────────────────────
# PostgreSQL 16+
DATABASE_URL=postgresql://sahyadri:sahyadri@localhost:5432/sahyadri
# Redis 7+, used by BullMQ jobs (notifications, stock-hold expiry, cart recovery) and cache
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────
# Long random strings (at least 32 bytes each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs OTP codes, private file links and the sandbox gateway. Required in production (32+ random bytes).
APP_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# OTP validity and attempts
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_WINDOW=5
# Development only: when set and NODE_ENV=development, every OTP is this value.
# Ignored in any other environment.
DEV_FIXED_OTP=123456

# ── Payment gateway (Razorpay assumed) ─────────────────────────────
# Fallback: COD stays available; sandbox keys run until live keys arrive.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify the X-Razorpay-Signature header on webhooks
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Business API (provider to be confirmed) ───────────────
# Fallback: click-to-chat wa.me link with pre-filled message, plus email.
# Set WHATSAPP_PROVIDER=clicktochat to run without an approved BSP.
WHATSAPP_PROVIDER=clicktochat
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ── SMS OTP (provider to be confirmed) ─────────────────────────────
# Fallback: email OTP for staff; DEV_FIXED_OTP in development only.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# DLT registration fields required for Indian SMS
SMS_DLT_ENTITY_ID=
SMS_DLT_OTP_TEMPLATE_ID=

# ── Email ──────────────────────────────────────────────────────────
# Fallback: queue and retry; every message is also visible in the admin.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sahyadri Pearls <no-reply@example.com>"

# ── Push notifications (Firebase Cloud Messaging) ──────────────────
# Fallback: WhatsApp and email carry the same order updates.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── File storage and CDN (S3-compatible) ───────────────────────────
# Fallback: STORAGE_DRIVER=local writes to ./uploads in development.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# ── AI model provider (Ring Finder ranking and explanations) ───────
# Fallback: plain filtered catalogue results.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=4000

# ── Pearl market-rate feed ─────────────────────────────────────────
# Off until a usable market source is confirmed. Fallback: the admin-managed manual rate table.
PEARL_RATE_FEED_URL=
PEARL_RATE_FEED_API_KEY=

# ── Backups (scripts/backup, run nightly by .github/workflows/backup.yml) ──
# s3://bucket/prefix in an India region, or a local folder
BACKUP_TARGET=
BACKUP_RETENTION_DAYS=30
