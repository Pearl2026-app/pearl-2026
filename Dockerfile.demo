# Presentation site in ONE container (free hosts such as Hugging Face Spaces): Postgres, the API in demo mode,
# the website, the admin, the two phone-app previews and a router on one port. Not for the real shop.
# Local:  docker build -f Dockerfile.demo -t sahyadri-demo . && docker run -p 7860:7860 sahyadri-demo
FROM node:22-bookworm-slim AS node

# Debian with PostgreSQL 16 (and the OpenSSL that Prisma needs); Node is copied in from the official image.
FROM postgres:16-bookworm AS base
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
  && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV PNPM_HOME=/pnpm PATH=/pnpm:/usr/lib/postgresql/16/bin:$PATH CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

FROM base AS build
COPY . .
# The website and admin reach the API inside the container; the rewrites are fixed at build time.
ENV API_INTERNAL_URL=http://127.0.0.1:4000
RUN pnpm install --frozen-lockfile \
    --filter "@sahyadri/api..." --filter "@sahyadri/web..." --filter "@sahyadri/admin..." \
    --filter "@sahyadri/mobile-customer..." --filter "@sahyadri/mobile-delivery..."
RUN pnpm --filter "@sahyadri/api..." build \
  && bash scripts/demo/export-apps.sh \
  && pnpm --filter "@sahyadri/web..." build \
  && pnpm --filter "@sahyadri/admin..." build

FROM base AS runtime
COPY --from=build /repo /repo
ENV API_INTERNAL_URL=http://127.0.0.1:4000 PORT=7860
# Free hosts run the container as an ordinary user (uid 1000); everything it writes goes to /tmp.
RUN useradd -m -u 1000 demo
USER demo
EXPOSE 7860
CMD ["bash", "/repo/scripts/demo/start.sh"]
